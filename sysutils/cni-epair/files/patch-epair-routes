+
+# gw_key <gateway> -- canonical form of a gateway, for COMPARISON ONLY.
+#
+# cmd_add hands jail_default_route a link-local IPv6 gateway with the interface
+# appended by hand (`fe80::1%eth0`), because route(8) cannot resolve an ambiguous
+# link-local without a scope. What `route -n get default` prints back for that
+# same route is not necessarily that string: route(8) renders a link-local gateway
+# from the kernel's scope id, which may name the interface differently than the
+# literal we were handed, and it normalises case and zero runs on the way out.
+# Comparing the two verbatim would read a working v6 route as a failure on all
+# three attempts and then log a WARNING about a route that is there -- which is
+# worse than the `|| true` it replaces, because it is a false alarm nobody
+# distrusts yet. Scope is a property of the interface, which both sides already
+# carry, so compare the address alone. No-ops for IPv4.
+gw_key() {
+    local key="$1"
+    key="${key#\[}"    # CNI passes [2001:db8::1] in some configurations
+    key="${key%%\]}"
+    key="${key%%\%*}"  # fe80::1%eth0 -> fe80::1
+    printf '%s\n' "$key" | tr 'A-Z' 'a-z'
+}
+
+# jail_default_route <jail id> <gateway> [route flags] -- install a default route
+# in a jail's routing table, and be sure it got there.
+#
+# This replaces `route -j $jid add default $gw || true`. That `|| true` is how a
+# container on this host can come up with an address, its segment and its own
+# nameserver -- so DNS answers -- and no way off the LAN, while the CNI result
+# says success and podman starts it happily. Six days later it looks like a dead
+# network, not like a half-configured jail. So:
+#
+#   * success is read back out of the kernel with `get default`, not from
+#     route(8)'s exit status or its output, because those disagree in both
+#     directions: `add` prints "add net default: gateway X" on its way out even
+#     when it then fails, and a jail whose route was installed by something else
+#     answers "route already in table" to a re-add that has nothing to complain
+#     about;
+#   * a different default already in the table is CHANGED rather than deleted and
+#     re-added, because a delete followed by a failed add leaves the jail worse
+#     off than it started;
+#   * route(8)'s stderr goes to the log instead of /dev/null, so the next failure
+#     says why instead of saying nothing (stdout is dropped: see above);
+#   * three attempts a second apart: whatever races here has been transient;
+#   * the read-back is compared with gw_key, not verbatim, because the gateway we
+#     were given and the gateway route(8) prints for it are not the same string.
+jail_default_route() {
+    local jid="$1" gw="$2" flags="$3" try err current want
+
+    want=$(gw_key "$gw")
+
+    for try in 1 2 3; do
+        # $flags is empty or "-inet6"; unquoted so the empty case leaves no word.
+        current=$(route -j "$jid" $flags -n get default 2>/dev/null |
+            awk '/^[[:space:]]*gateway:/{print $2; exit}')
+        if [ "$(gw_key "$current")" = "$want" ]; then
+            [ "$try" -gt 1 ] && log "jail $jid: default route via $gw installed on attempt $try"
+            return 0
+        fi
+
+        if [ -n "$current" ]; then
+            err=$(route -j "$jid" $flags change default "$gw" 2>&1 >/dev/null) ||
+                err="$err; delete/add: $(
+                    route -j "$jid" $flags delete default 2>&1 >/dev/null
+                    route -j "$jid" $flags add default "$gw" 2>&1 >/dev/null)"
+        else
+            err=$(route -j "$jid" $flags add default "$gw" 2>&1 >/dev/null)
+        fi
+
+        # Read it back before saying anything, so a repair that worked is quiet
+        # and instant and the log only carries the ones that did not.
+        current=$(route -j "$jid" $flags -n get default 2>/dev/null |
+            awk '/^[[:space:]]*gateway:/{print $2; exit}')
+        [ "$(gw_key "$current")" = "$want" ] &&
+            { log "jail $jid: default route via $gw restored on attempt $try"; return 0; }
+        log "jail $jid: default route via $gw not installed (attempt $try): ${err:-route(8) reported no error, and the table still disagrees}"
+        # Back off between attempts, not after the last one: that sleep buys
+        # nothing and every second of it is a second the container is not running
+        # yet, spent inside cmd_add under the CNI client's timeout.
+        [ "$try" -lt 3 ] && sleep 1
+    done
+    return 1
 }
 
